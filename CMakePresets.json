{
  "version": 6,
  "configurePresets": [
    {
      "name": "host-linux",
      "displayName": "Host Linux (Ninja, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DGCPAIN_KERNEL_BRUSH": "ON",
        "DGCPAIN_RENDER_VULKAN": "ON",
        "DGCPAIN_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "host-linux-sanitize",
      "displayName": "Host Linux (Ninja, Debug, ASan+LSan)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-linux-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DGCPAIN_KERNEL_BRUSH": "ON",
        "DGCPAIN_RENDER_VULKAN": "ON",
        "DGCPAIN_BUILD_TESTS": "ON",
        "DGCPAIN_SANITIZE": "ON"
      }
    },
    {
      "name": "host-windows",
      "displayName": "Host Windows (Ninja, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DGCPAIN_KERNEL_BRUSH": "ON",
        "DGCPAIN_RENDER_VULKAN": "ON",
        "DGCPAIN_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a (NDK toolchain)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android-arm64",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-30",
        "ANDROID_STL": "c++_static",
        "DGCPAIN_KERNEL_BRUSH": "ON",
        "DGCPAIN_RENDER_VULKAN": "ON",
        "DGCPAIN_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-linux",
      "configurePreset": "host-linux"
    },
    {
      "name": "host-linux-sanitize",
      "configurePreset": "host-linux-sanitize"
    },
    {
      "name": "host-windows",
      "configurePreset": "host-windows"
    },
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64"
    }
  ]
}
